# Copy to .env in the repo root. The Go commands (migrate, api, worker, mockacct) and the
# tests load it. A variable already set in your shell wins over this file.

# Neon: use the DIRECT connection string (host without "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Integration tests: any throwaway PostgreSQL 14+ (a Neon branch, local, or Docker).
# Every test creates its own schema and drops it afterwards.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sutra_test?sslmode=disable

# Optional — the defaults are shown.
# API_ADDR=:8080
# MOCK_ADDR=:8081
# ACCOUNTING_URL=http://localhost:8081

# Mock accounting misbehaviour (the brief's numbers).
# MOCK_FAIL_RATE=0.2
# MOCK_HANG_RATE=0.1
# MOCK_HANG_DURATION=5s

# Sync worker.
# WORKER_CONCURRENCY=4
# WORKER_MAX_ATTEMPTS=5
# WORKER_HTTP_TIMEOUT=8s
# WORKER_LEASE=15s
