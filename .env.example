# Copy to .env in the repo root. The Go commands (migrate, api, worker, mockacct) load it.

# Neon: use the DIRECT connection string (host without "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Integration tests: any throwaway PostgreSQL 14+ (local, or a Neon branch).
# Every test creates its own schema and drops it afterwards.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sutra_test?sslmode=disable
